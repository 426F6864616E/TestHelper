; TestHelper installer (Inno Setup 6). Built by installer\build.ps1.
#define AppName "TestHelper"
#define AppVersion "1.0"
#define AppExe "TestHelper.exe"

[Setup]
AppId={{6B1E4C2A-9D3F-4E7A-8C21-5F0A7B3D9E14}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=426F6864616E
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir=..\dist\installer
OutputBaseFilename=TestHelper-{#AppVersion}-Setup
; Separate installer icon (app icon + "install" badge), generated by make_setup_icon.py
SetupIconFile=setup.ico
; App icon in the wizard's top-right corner (several sizes for different DPI)
WizardSmallImageFile=wizard-small-55.bmp,wizard-small-64.bmp,wizard-small-69.bmp,wizard-small-83.bmp,wizard-small-92.bmp,wizard-small-110.bmp,wizard-small-119.bmp,wizard-small-138.bmp
UninstallDisplayIcon={app}\{#AppExe}
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
CloseApplications=yes
; Language = Windows display language, no selection dialog.
; If that language isn't in [Languages], the first one (English) is used.
LanguageDetectionMethod=uilanguage
ShowLanguageDialog=no

[Languages]
; english must be FIRST — it is the fallback language
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "ukrainian"; MessagesFile: "compiler:Languages\Ukrainian.isl"
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "..\dist\TestHelper\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#AppExe}"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
Filename: "{cmd}"; Parameters: "/C taskkill /IM {#AppExe} /F"; Flags: runhidden; RunOnceId: "KillApp"
